---
interface Props {
  title: string;
  activeSlug?: string;
  topics: {
    name: string;
    id: string;
    items: {
      title: string;
      slug: string;
      order: number;
    }[];
  }[];
}

const { title, activeSlug, topics } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | 知識庫</title>
  <style>
    :root {
      --sidebar-width: 280px;
      --primary-color: #2563eb;
      --bg-color: #f8fafc;
      --text-color: #1e293b;
      --border-color: #e2e8f0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--text-color);
      background-color: var(--bg-color);
      display: flex;
      min-height: 100vh;
    }
    /* 側邊欄樣式 */
    aside {
      width: var(--sidebar-width);
      background: #ffffff;
      border-right: 1px solid var(--border-color);
      padding: 1.5rem 1rem;
      height: 100vh;
      position: sticky;
      top: 0;
      overflow-y: auto;
    }
    .brand {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 2rem;
      display: block;
      color: var(--primary-color);
      text-decoration: none;
    }
    .topic-group {
      margin-bottom: 1.5rem;
    }
    .topic-title {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #64748b;
      margin-bottom: 0.5rem;
      padding-left: 0.5rem;
    }
    .nav-list {
      list-style: none;
    }
    .nav-item a {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.95rem;
      color: #334155;
      text-decoration: none;
      border-radius: 6px;
      margin-bottom: 2px;
      transition: background 0.15s ease;
    }
    .nav-item a:hover {
      background: #f1f5f9;
      color: var(--primary-color);
    }
    .nav-item a.active {
      background: #eff6ff;
      color: var(--primary-color);
      font-weight: 600;
    }
    /* 主內容區樣式 */
    main {
      flex: 1;
      max-width: 900px;
      padding: 3rem 4rem;
      margin: 0 auto;
      background: #ffffff;
      min-height: 100vh;
      border-left: 1px solid var(--border-color);
    }
    .article-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-color);
    }
    .article-header .badge {
      font-size: 0.8rem;
      background: #e0e7ff;
      color: #3730a3;
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 0.75rem;
    }
    .markdown-body {
      line-height: 1.75;
      font-size: 1.05rem;
    }
    .markdown-body h2 { margin: 2rem 0 1rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.3rem; }
    .markdown-body h3 { margin: 1.5rem 0 0.75rem; }
    .markdown-body p { margin-bottom: 1.25rem; }
    .markdown-body ul, .markdown-body ol { margin-bottom: 1.25rem; padding-left: 1.5rem; }
    .markdown-body pre { background: #0f172a; color: #f8fafc; padding: 1rem; border-radius: 8px; overflow-x: auto; margin-bottom: 1.25rem; }
  </style>
</head>
<body>
  <aside>
    <a href="/" class="brand">📖 知識網誌庫</a>
    {topics.map((topic) => (
      <div class="topic-group">
        <div class="topic-title">{topic.name}</div>
        <ul class="nav-list">
          {topic.items.map((item) => (
            <li class="nav-item">
              <a
                href={`/docs/${item.slug}/`}
                class={activeSlug === item.slug ? "active" : ""}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </aside>

  <main>
    <slot />
  </main>
</body>
</html>