---
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');
// 依 order 排序出第一篇文章
const sortedDocs = allDocs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const firstDoc = sortedDocs[0];

// 取得 astro.config.mjs 設定的 base 路徑 (例如 /my-knowledge-base/)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// 自動加上 base 前綴
const targetUrl = firstDoc 
  ? `${base}/docs/${firstDoc.slug}/` 
  : `${base}/admin/`;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <title>轉導中...</title>
  </head>
  <body>
    <p>正在前往文章庫，請稍候... 若未自動跳轉，請<a href={targetUrl}>點此進入</a>。</p>
  </body>
</html>